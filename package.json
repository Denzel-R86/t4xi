{
  "name": "t4xi-nl",
  "version": "2.0.0",
  "private": true,
  "description": "T4XI.nl — Premium Dutch taxi & electric mobility platform",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:staging": "tsx scripts/dev-staging.ts",
    "studio": "sanity dev",
    "typegen": "sanity schema extract --path=sanity/generated/schema.json --enforce-required-fields --force && sanity typegen generate",
    "cms:seed": "sanity exec scripts/seed-sanity-content.ts --with-user-token --",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"lib/**/*.test.ts\"",
    "pricing:import": "tsx scripts/import-fixed-routes.ts",
    "brain:analyze": "tsx scripts/brain-analyze.ts",
    "brain:simulate": "tsx scripts/brain-simulate.ts",
    "test:brain": "tsx --test lib/pricing-brain/brain.test.ts",
    "test:rates": "tsx --test lib/pricing/*.test.ts",
    "test:payments": "tsx --test lib/payments/*.test.ts",
    "test:notifications": "tsx --test lib/notifications/*.test.ts",
    "test:invoices": "tsx --test lib/invoices/*.test.ts",
    "test:admin": "tsx --test lib/admin/*.test.ts",
    "test:cms": "tsx --test lib/cms/*.test.ts",
    "preview:invoice-email": "tsx scripts/verify-invoice-email.ts"
  },
  "dependencies": {
    "@sanity/icons": "5.2.1",
    "@sanity/image-url": "^1.0.2",
    "@stripe/react-stripe-js": "^6.8.0",
    "@stripe/stripe-js": "^9.12.0",
    "@supabase/ssr": "^0.5.0",
    "@supabase/supabase-js": "^2.45.0",
    "next": "16.3.0",
    "next-intl": "^4.13.3",
    "next-sanity": "13.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanity": "6.9.1",
    "stripe": "^22.3.2",
    "styled-components": "6.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "autoprefixer": "^10.4.19",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4"
  },
  "overrides": {
    "@module-federation/dts-plugin": {
      "undici": "7.29.0"
    },
    "@vercel/frameworks": {
      "js-yaml": "3.15.1",
      "smol-toml": "1.6.1"
    }
  }
}
