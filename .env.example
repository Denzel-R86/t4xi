# Logische app-omgeving: development | staging | production.
# Leidend voor de omgevings-guard (NIET NODE_ENV). Laat op development staan;
# staging/production worden per deploy (of via .env.staging.local) gezet.
APP_ENV=development

# Supabase — vul per omgeving. Laat de URL hier LEEG (geen productie-ref in het
# voorbeeldbestand). Productie-ref hoort uitsluitend in de productie-deploy.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only (nooit NEXT_PUBLIC): service-role key voor server-side writes.
SUPABASE_SERVICE_ROLE_KEY=

# Google Places API (New) — alleen server-side gebruiken, nooit NEXT_PUBLIC
GOOGLE_PLACES_API_KEY=

# Google Maps Directions API — server-only. Voedt het afstand-tarief (bindende
# prijs voor ritten zonder vaste route, zie lib/pricing/routing.ts). Zonder deze
# key valt de prijsservice terug op "offerte op aanvraag" (gedrag van vóór de
# feature). De Directions API moet in Google Cloud zijn ingeschakeld.
GOOGLE_MAPS_API_KEY=

# Sanity CMS (Fase 3)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# ── Stripe (test mode) — Sprint 1 ────────────────────────────────────────────
# Testsleutels uit het Stripe Dashboard (Developers > API keys). Nooit committen:
# de echte waarden horen in .env.local (git-ignored), niet in dit voorbeeldbestand.
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Webhook signing secret (Developers > Webhooks, of `stripe listen`): whsec_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
